.sidebar
    div(class="sidebar-header")
        h1
            | Đoạn chat
            div(class="header-actions")
                a(
                    href="/"
                    class="tab"
                    title="Trang chủ"
                ) HOME

        div(class="search-box")
            form(
                method="GET",
                form-search
            )
                span(class="search-icon") 
                input(
                    type="text" 
                    placeholder="Tìm kiếm trên Messenger"
                )

    div(class="tabs")
        button(class="tab active") Tất cả
        button(class="tab") Bạn bè
        button(class="tab") Nhóm
    div(class="conversation-list")
        each item in myRoom
            div(
                data-room = item._id
                class="conv-item"
            )
                div(class="avatar-wrap")
                    div(class="avatar av-purple")
                        img(
                            src=(item.type_room == "friend" ? item.infoFriend.avatar : item.avatar)
                        )
                    if(item.type_room == "friend")
                        div(
                            class=(item.infoFriend.statusOnline == "online" ? "online-dot" : "")
                            data-status-online
                        )
                div(class="conv-info")
                    div(class="conv-name") #{(item.type_room == "friend" ? item.infoFriend.userName : item.title)}
                    //- .conv-preview Tôi lên trường r · 2 ngày
    script(type="module" src="/JS/sidebarChat.js") 