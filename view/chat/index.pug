extends ../layout/chat-default.pug

block main
    .chat-area
        .chat-header
            .avatar-wrap
                .avatar.av-purple(style="width:40px;height:40px") 
                    img(
                        data-room = roomChat
                        src=(roomChat.type_room == "friend" ? roomChat.infoFriend.avatar : roomChat.avatar)
                    )
                    if(roomChat.type_room == "friend")
                        div(class=(roomChat.infoFriend.statusOnline == "online" ? "online-dot" : ""))
            .chat-user-info
                if(roomChat.type_room == "friend")
                    h2 #{roomChat.infoFriend.userName}
                    if(roomChat.infoFriend.statusOnline == "online")
                        span Đang hoạt động
                else
                    h2 #{roomChat.title}
        div(
            class="messages"
            id="messages"
            data-user
            myID = Myuser._id
        )
            each chat in chats
                if(chat.user_id == Myuser._id)
                    div(class="msg-row out")
                        div(class="bubble out") #{chat.content}
                else 
                    div(class="msg-row")
                        div(class="msg-avatar") 
                            img(
                                src = chat.infoUser.avatar
                                width="30"
                                style="border-radius: 30px;"
                            )
                        div(class="bubble in") #{chat.content}
            .inner-list-typing
        .chat-input
            form(
                form-chat
            )
                //- button(class="input-btn") 🎤
                //- button(class="input-btn") 🖼️
                //- button(class="input-btn") 🙂
                //- button(class="input-btn"style="font-size:13px;font-weight:700") GIF

                div(class="input-field-wrap")
                    input(
                        id="msgInput" 
                        type="text" 
                        placeholder="Aa"
                        name="content"
                    )
                button(type="button" class="input-btn" id="emojiBtn") 🙂

                //- button.input-btn.like-btn(onclick="sendLike()") 👍
    div(class="tooltip" role="tooltip")
        emoji-picker
block script
    script(type="module" src="/JS/chat.js") 