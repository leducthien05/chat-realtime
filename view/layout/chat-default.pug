doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Messenger
    link(href="https://fonts.googleapis.com/css2?family=Segoe+UI:wght@400;500;600;700&display=swap" rel="stylesheet")
    //- FilePond
    link(rel="stylesheet" type="text/css" href="https://unpkg.com/filepond/dist/filepond.min.css")
    link(rel="stylesheet", href="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.min.css")
    //- View
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/viewerjs/1.11.6/viewer.min.css")
    link(rel="stylesheet", href="/CSS/chat.css")
  body
    // ❗ giữ đúng structure gốc: KHÔNG bọc thêm div
    include ../partial/sidebarChat.pug

    // 👉 phần thay đổi
    block main
      

    include ../partial/info.pug
    //- Emoji-picker-element
    script(type="module" src="https://cdn.jsdelivr.net/npm/emoji-picker-element@^1/index.js")
    //- FilePond
    script(src="https://unpkg.com/filepond/dist/filepond.min.js") 
    script(src="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.min.js") 
    script(src="https://unpkg.com/filepond-plugin-file-validate-type/dist/filepond-plugin-file-validate-type.min.js") 
    //- View
    script(src="https://cdnjs.cloudflare.com/ajax/libs/viewerjs/1.11.6/viewer.min.js") 
    script(src="/socket.io/socket.io.js")
    script(src="/JS/socket.js") 
    block script